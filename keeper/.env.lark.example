# Keeper config for lark1. Copy to keeper/.env and fill VAULT/REBALANCE_PROXY from
# lark/deployments/lark1.json (written by lark/01-deploy.ts).
RPC_URL=https://1.lark.hydration.cloud

# Deployer = Anvil#0. With ENTRYPOINT=proxy this only needs to be the address
# registered as the vault's rebalancer, not the owner. 0x + 64 hex.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

VAULT=
# --- access model: bounded rebalancer key (Model B) ---
ENTRYPOINT=proxy
REBALANCE_PROXY=

# Protocol-fee cut recipient (Hypervisor.fee is a divisor: 5 => 20%).
FEE_RECIPIENT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Strategy. REBALANCE_THRESHOLD_MULT=2 is what makes the demo's drift swap
# trigger a re-center. BASE_HALF_WIDTH_MULT must MATCH the value configure-guards
# used to set the initial band — otherwise the first rebalance is a width change
# larger than the proxy's maxWidth and the keeper skips every block forever.
# (The keeper detects and reports this at startup.)
BASE_HALF_WIDTH_MULT=10
LIMIT_WIDTH_MULT=1
REBALANCE_THRESHOLD_MULT=2

# Gates. The lark GLMR/ASTR pool needs its observation ring grown AND filled
# before a TWAP is readable — 01-deploy.ts grows it, but a freshly grown pool has
# no history, so the keeper will fail closed until MIN_TWAP_WINDOW_SECS of
# trading has accumulated. That is the correct behaviour; wait it out rather than
# turning the gate off.
MIN_INTERVAL_SECS=600
DWELL_BLOCKS=3
TWAP_ENABLED=true
TWAP_WINDOW_SECS=600
MIN_TWAP_WINDOW_SECS=300
MAX_DEV_TICKS=100
ALLOW_UNSAFE_SPOT=false
MINS_TOLERANCE_BPS=1000

# No price feed for ASTR/GLMR on lark — the pool TWAP is the only reference here.
# Enable for pairs that do have one (aDOT/HOLLAR: set ORACLE_FEED0 to the
# AggregatorV3 DOT/USD address; see .env.mainnet.example).
ORACLE_ENABLED=false

# lark tx submission.
GAS_LIMIT=3000000
CONFIRMATIONS=3
POLL_INTERVAL_MS=4000
DRY_RUN=false
