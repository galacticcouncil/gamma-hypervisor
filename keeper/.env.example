# --- network ---
RPC_URL=http://127.0.0.1:9999

# Signer. In ENTRYPOINT=direct this MUST be the vault owner (rebalance is onlyOwner).
# In ENTRYPOINT=proxy it is the low-privilege rebalancer key registered on the
# RebalanceProxy — that is the one to use anywhere real.
# Default below is the local zombienet deployer (Charlie's EVM dev key). 0x + 64 hex.
PRIVATE_KEY=0x653a29ac0c93de0e9f7d7ea2d60338e68f407b18d16d6ff84db996076424f8fa

# Gamma Hypervisor (vault). Default = local zombienet deployment.
VAULT=0xE80EF6C516fd3b12037Ca1708e77a1d78AF8db5E

# --- several vaults in one process (optional) ---
# Everything in this file is the DEFAULTS layer. Leave the two variables below
# unset and the keeper runs exactly one vault, the VAULT above — which is what
# every existing deployment does.
#
# Set one of them to run N pools from this one process, one signer, one nonce:
#   VAULTS_JSON   an inline JSON ARRAY of per-vault override objects
#   VAULTS_FILE   a path to a file holding that same array (wins if both are set)
#
# Each element is a PARTIAL: merged over the defaults above, then validated with
# the same rules, per vault. A key set to null drops the inherited default.
# Duplicate vault addresses are rejected. GLOBAL settings (RPC_URL, PRIVATE_KEY,
# POLL_INTERVAL_MS, CONFIRMATIONS, GAS_*, DRY_RUN, STARTUP_LOOKBACK_BLOCKS,
# INDEXER_URL, INDEXER_TIMEOUT_MS, MM_DATA_PROVIDER) may NOT appear in it.
#
# BASE_HALF_WIDTH_MULT is per vault and must be: it counts tickSpacings, and a
# different fee tier is a different spacing.
# VAULTS_JSON=[{"VAULT":"0xE80E…db5E"},{"VAULT":"0x1234…5678","BASE_HALF_WIDTH_MULT":96}]
# VAULTS_FILE=/run/config/vaults.json

# --- access model ---
# direct = Model A: signer owns the vault outright. Local/dev only — a leaked key
#          is total loss of the vault.
# proxy  = Model B: signer is a revocable rebalancer key; RebalanceProxy enforces
#          minInterval / maxTranslation / maxWidth ON-CHAIN. Use this in prod.
ENTRYPOINT=direct
# REBALANCE_PROXY=0x...   # required when ENTRYPOINT=proxy

# Recipient of the protocol-fee cut. Hypervisor.fee is a DIVISOR: fee=5 => 20% of
# accrued swap fees, re-set from this argument on EVERY rebalance. Point it at the
# Treasury. Required for live runs (DRY_RUN=false).
FEE_RECIPIENT=0xC19A2970A13ac19898c47d59Cbd0278D428EBC7c

# --- strategy (units are multiples of the pool's tickSpacing) ---
BASE_HALF_WIDTH_MULT=10
LIMIT_WIDTH_MULT=1
REBALANCE_THRESHOLD_MULT=5

# --- fold at balance (opt-in, default off) ---
# Bank a half-traversed limit order into the base before it converts all the
# way through and reflects. Fires when the limit's own composition reaches
# FOLD_MIN_SHARE mixed; same zero-translation rebalance as a limit refresh
# (base ticks unchanged), same dwell/cooldown/price gates. Backtested on three
# real DIA tapes: the only variant that beat the recenter+refresh baseline on
# all of them (keeper/sim/).
FOLD_ENABLED=false
# 0.4 = fold once the limit is at least 40/60 mixed by value.
FOLD_MIN_SHARE=0.4
# Skip limits under this fraction of NAV — a dust fold wastes a cooldown slot.
FOLD_MIN_LIMIT_SHARE=0.05

# --- anti-manipulation gates ---
# Spot only TRIGGERS a rebalance; with TWAP_ENABLED the band is CENTERED on the
# TWAP tick, so pushing spot cannot drag the band to the pushed price.
MIN_INTERVAL_SECS=600
# How long the trigger must hold CONTINUOUSLY before a rebalance is armed.
# DWELL_SECS is the knob. DWELL_BLOCKS is the deprecated spelling: it counted
# EVALUATED blocks, which are skipped while an evaluation is in flight, so with
# several vaults in one process the same number quietly meant a longer and
# longer interval. Left unset, DWELL_SECS is derived as
# DWELL_BLOCKS x (block time measured at startup) and logged loudly.
DWELL_SECS=6
DWELL_BLOCKS=3
TWAP_ENABLED=true
TWAP_WINDOW_SECS=3600
MIN_TWAP_WINDOW_SECS=600
MAX_DEV_TICKS=100
# Escape hatch to run live without a TWAP gate. Throwaway local chains ONLY —
# on a fresh zombienet the pool has no observation history yet.
ALLOW_UNSAFE_SPOT=false

# Slippage bound per burn/mint leg, in bps of the expected amount.
MINS_TOLERANCE_BPS=1000

# --- external oracle clamp (Chainlink AggregatorV3 feeds) ---
# The pool TWAP is walkable with enough capital and patience; an exchange-fed
# oracle is not. Strongly recommended for any pair that has a feed, and REQUIRED
# at launch -- see .env.mainnet.example.
#
# NOT DIA getValue(string): DIA supplies the data, but Hydration serves it through
# AggregatorV3 and every mainnet feed reverts on getValue(). One contract per
# pair, so feeds are ADDRESSES and there are no key strings.
ORACLE_ENABLED=false
# ORACLE_FEED0=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702   # mainnet DOT/USD
# Which pool side ORACLE_FEED0 prices. The pool tick is token1-per-token0, so a
# feed on token1 must be inverted. Wrong value = oracle tick far from the pool =
# every rebalance silently skipped. aDOT/HOLLAR sorts aDOT (the DOT feed's side)
# first, because both are Erc20 and sort by contract: 0x0263... < 0x531a...
# ORACLE_FEED0_SIDE=token0
# ORACLE_FEED1=0x...           # token1/USD; omit if token1 is the USD side
# ORACLE_MAX_AGE_SECS=600
# ORACLE_MAX_DEV_TICKS=200

# --- operations ---
GAS_FLOOR_WEI=0
GAS_LIMIT=3000000
CONFIRMATIONS=3
POLL_INTERVAL_MS=2000
STARTUP_LOOKBACK_BLOCKS=50000

# --- run mode ---
DRY_RUN=false
