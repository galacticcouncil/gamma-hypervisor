# ---------------------------------------------------------------------------
# Gamma keeper — MAINNET launch profile (aDOT / HOLLAR, 0.3%)
#
# Every value here is a launch decision, not a default. The shipped defaults in
# .env.example are laptop-scale: oracle clamp OFF, ±6% band, 18-second dwell,
# 10-minute cooldown. Running those against real money would let a spot push
# that survives three blocks drag the band.
#
# Source: garden wiki note-gamma-adot-hollar-alm-spec §C/§D.
# ---------------------------------------------------------------------------

RPC_URL=https://rpc.hydradx.cloud

# Low-privilege rebalancer key registered on the RebalanceProxy. NOT the owner.
PRIVATE_KEY=
VAULT=

# --- access model: bounded rebalancer key (Model B) ---
# Never `direct` on mainnet: a leaked key would be total loss of the vault.
# In proxy mode the on-chain caps (minInterval / maxTranslation / maxWidth) hold
# even if this key is compromised.
ENTRYPOINT=proxy
REBALANCE_PROXY=

# Hypervisor.fee is a DIVISOR (5 => 20% of accrued swap fees), re-asserted on
# every rebalance. Must be the treasury / buyback executor, never the keeper key.
FEE_RECIPIENT=

# --- strategy (multiples of tickSpacing; 0.3% tier => spacing 60) ---
# ±10% half-width = ln(1.10)/ln(1.0001) = 953 ticks; 953/60 = 15.9 -> 16.
# 16 * 60 = 960 ticks = +10.08% / -9.16%. (The shipped default 10 is ±6.2%.)
# Do not tighten below this until 4 consecutive weeks of positive net markout.
BASE_HALF_WIDTH_MULT=16
LIMIT_WIDTH_MULT=1
# Re-center once spot has drifted ~70% of the half-width from center: 0.7*16 ≈ 11.
REBALANCE_THRESHOLD_MULT=11

# --- anti-manipulation gates ---
# 6h cooldown mirrors the RebalanceProxy's own minInterval — keep them equal so
# the keeper does not burn gas on calls the proxy will reject.
MIN_INTERVAL_SECS=21600
# Dwell ~30 min at 6s blocks: a spike must persist across 300 evaluated blocks,
# which costs an attacker real capital held against arbitrage the whole time.
DWELL_BLOCKS=300
TWAP_ENABLED=true
# MUST match ClearingV2.twapInterval and the pool's observation cardinality.
# A ring of C slots covers (C-1)*6s, so 3600s needs C >= 601; the launch scripts
# set 720. Reconcile all three before launch — there is no shared constant.
TWAP_WINDOW_SECS=3600
# Refuse to place a band off a short average. The shipped 600 would let the
# keeper act on a 10-minute TWAP during the pool's warm-up, which is far more
# walkable than the hour it is supposed to be using.
MIN_TWAP_WINDOW_SECS=3000
# 50 ticks ≈ 0.5%, per spec §D2.3. The shipped 100 is 1.0%.
MAX_DEV_TICKS=50
ALLOW_UNSAFE_SPOT=false

# Coupled to BASE_HALF_WIDTH_MULT — see the note in src/config.ts.
MINS_TOLERANCE_BPS=1000

# --- external oracle clamp: REQUIRED at launch ---
# Chainlink AggregatorV3 feeds, one contract per pair. NOT DIA getValue(string):
# DIA supplies the data but Hydration serves it through AggregatorV3, and every
# mainnet feed reverts on getValue() (verified 2026-08-21).
#
# aDOT is 1:1 with DOT (the balance rebases, the price does not), so the DOT/USD
# feed IS the aDOT price — no index factor.
ORACLE_ENABLED=true
ORACLE_FEED0=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702
# HOLLAR is the USD-pegged side: leave blank and token0/USD is the pool price.
ORACLE_FEED1=
# The DOT feed updates every ~2 minutes; 600s is ~5 missed updates.
ORACLE_MAX_AGE_SECS=600
# 50 ticks ≈ 0.5%, same rule as MAX_DEV_TICKS. The shipped 200 is 4x looser.
ORACLE_MAX_DEV_TICKS=50

# --- operations ---
GAS_FLOOR_WEI=1000000000000000000
GAS_LIMIT=3000000
CONFIRMATIONS=3
POLL_INTERVAL_MS=6000
STARTUP_LOOKBACK_BLOCKS=50000

DRY_RUN=false

# ---------------------------------------------------------------------------
# Vault caps — NOT keeper settings. Applied at deploy time by
# gamma-hypervisor/lark/01-deploy.ts (or zombienet/deploy-gamma.ts), listed here
# so the whole launch configuration reads in one place.
#
# Hypervisor.sol fixes maxTotalSupply and the per-tx maxima AT CONSTRUCTION, wide
# open (0 = no cap, uint256(-1) = unlimited), and ships no setters for them. They
# are enforced on ClearingV2 instead, which is the layer every deposit passes
# through. Two calls are needed, not one: `customDeposit` stores the per-tx
# maxima and `setDepositOverride(pos, true)` is what makes clearDeposit read them.
# Without the second call the caps are inert.
#
#   MAX_TOTAL_SUPPLY   ~$250k of vault shares      (spec §B guarded launch)
#   DEPOSIT0_MAX       ~$50k of token0 per tx      (blunts single-block games)
#   DEPOSIT1_MAX       ~$50k of token1 per tx
#   HYPERVISOR_FEE     Gamma cut, a DIVISOR: 5 = 20% (contract default),
#                      255 = ~0.4% (spec D3 launch leaning). NEVER 0 — that
#                      reverts every harvest and bricks deposit/withdraw/rebalance.
#
# Raw units: aDOT 10 decimals, HOLLAR 18. Shares are 18. Fill from the seed price
# on the day — left blank so nobody ships a stale figure.
# MAX_TOTAL_SUPPLY=
# DEPOSIT0_MAX=
# DEPOSIT1_MAX=
# HYPERVISOR_FEE=255

# ---------------------------------------------------------------------------
# Deploy-time roles (gamma-hypervisor deploy scripts, not the keeper)
#
# GOVERNANCE_ADDRESS becomes Admin's admin — the role that can move vault
# ownership, reassign the rebalancer and advisor, set the fee and rescue tokens.
# On Hydration that is GOVERNANCE, not a Safe: an OpenGov referendum is the
# multi-party approval. Governance acts as the EVM address whose first 20 bytes
# match a dispatch account it controls:
#
#   0xaa7e0000000000000000000000000000000aa7e0
#     via dispatcher.dispatchAsAaveManager (Root or the EconomicParameters track)
#     — already the Aave market's ACLManager admin, so the path is proven
#
# The deploy keeps the deployer as admin while it wires everything, then hands
# over as its LAST action. Leave blank and the deployer keeps it — fine on a
# throwaway chain, wrong anywhere else.
# GOVERNANCE_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0
#
# KEEPER_ADDRESS becomes Admin's advisor, which is what makes `compound`
# reachable at all (it defaults to the zero address, so today nothing can call
# it). Safe for a hot key: compound harvests fees and re-mints THE SAME ticks —
# it cannot move the band, move the price, or withdraw.
# KEEPER_ADDRESS=
