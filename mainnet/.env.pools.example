# Shared settings for the pools 2-5 Gamma stack: ONE fresh HypervisorFactory /
# ClearingV2 / UniProxy / Admin / RebalanceProxy, one vault per pool file.
# Copy to .env.pools and set DEPLOYER_PK.
#
#   ENV_FILE=.env.pools ./launch-pool.sh pools/atbtc-hollar.env     # per pool: preflight, deploy, configure
#   ENV_FILE=.env.pools npm run transfer-ownership -- --check        # read-only: every pool configured?
#   ENV_FILE=.env.pools npm run transfer-ownership                   # ONCE, last: every owner role -> governance
#
# Per-pool keys (lib.js POOL_KEYS) must NOT appear here: the scripts refuse to
# run if they do, so no vault can inherit another pool's token, feed or caps.
NET=mainnet
CHAIN_ID=222222
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# The shared stack. Records land in deployments/<NET>-<STACK>-*.json, apart from
# pool 1's deployments/mainnet.json, which nothing here can touch.
STACK=cl2
# Every pool of the stack. transfer-ownership refuses unless the stack's factory
# holds exactly these vaults, each configured.
STACK_POOLS=atbtc-hollar,apaxg-hollar,geth-hollar,gsol-hollar

DEPLOYER_PK=
GOVERNANCE_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0
# Same split as pool 1: ClearingV2 on the Technical Committee identity.
CLEARING_OWNER=0xaa7e0000000000000000000000000000000aa7e1
ALLOW_DEPLOYER_OWNER=false
# One keeper process runs every vault with ONE signer, so this is the key pool 1's
# keeper already signs with. Runbook §7 lists the choice.
KEEPER_ADDRESS=0x0B0bE14C1158Ba09B720812e70F819366614Cb96
# Treasury H160, as pool 1. The keeper vault files carry the same value.
FEE_RECIPIENT=0x6d6f646c70792f74727372790000000000000000
SEED_TO=0x6d6f646c70792f74727372790000000000000000
# The live, runtime-registered Uniswap v3 factory. Never a new one.
V3_FACTORY=0x776c4Fd6A6170165a91bA45Dec40a14bcc8eC354

HYPERVISOR_FEE=255
PRICE_THRESHOLD=10100
TWAP_INTERVAL=3600
DEPOSIT_DELTA=10010
ANCHOR_MAX_DEV_TICKS=200
TWAP_WINDOW_SECS=3600
BLOCK_TIME_SECS=2
MAX_DIVERGENCE_BPS=200
MM_DATA_PROVIDER=0xdf18300261edfF47b28c6a6adBCBCf468B52e5a5
GOVERNANCE_TRACK=minimum
GAS_PRICE_MULT=4
EVM_GAS_LIMIT=15000000
CONFIRMATIONS=2
