# 12-tc-caps.js — print the Technical Committee motion that raises the vault's
# share cap. Read-only: nothing is signed or submitted.
#
#   cp .env.tc-caps.example .env.tc-caps
#   ENV_FILE=.env.tc-caps node 12-tc-caps.js 250000      # the new cap, in shares

NET=mainnet
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# Live mainnet Gamma contracts. The script checks them on chain before use:
# ClearingV2 must know the vault, and its owner must be 0xaa7e…aa7e1.
VAULT=0xa206D0959813f17c17C87147271C49065438648A
CLEARING=0x3541A3E5Db2d611904BE4F45A3CAFEA9A4df3e48

# Gas budget for the inner evm.call. customDeposit itself needs about 100k.
TC_CALL_GAS=500000

# The motion carries a max gas price of eth_gasPrice x this. A motion can wait
# days for its votes, so leave headroom: the call still pays only the base fee,
# but it fails if the base fee has risen above this cap by the time it closes.
GAS_PRICE_MULT=20
