# Every .env variant — real runs carry DEPLOYER_PK. `.env` alone is not enough:
# a stray backup like .env.backup or .env.lark4 would silently redirect a
# mainnet command at another chain.
.env*
!.env.example
!.env.anchor.example
node_modules/
# Deployment records are the launch archive — the addresses are nonce-derived
# and exist nowhere else. Keep the JSON, keep everything else out.
deployments/*
!deployments/*.json
