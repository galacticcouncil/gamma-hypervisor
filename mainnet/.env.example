# Copy to a separately named, untracked file such as .env.mainnet. Run every
# command with ENV_FILE=.env.mainnet so a fork configuration cannot be used by
# accident.
#
# This launch runs AFTER uniswap-v3-deploy/mainnet has created and initialized
# the aDOT/HOLLAR pool. Every V3_* value below must come from that launch's
# `deployments/mainnet.json` and `deployments/mainnet-pool.json` — the preflight
# proves the factory really does own the configured pool before anything else.

# Target -----------------------------------------------------------------
NET=mainnet
CHAIN_ID=222222
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# Deployer ---------------------------------------------------------------
# Needs WETH (asset 20) for gas, and must be an UNBOUND EVM address: a key with
# an `EVMAccounts::AccountExtension` entry is resolved through bound_account_id,
# so funding its `ETH\0`-truncated account has no effect. A fresh key is unbound.
DEPLOYER_PK=

# Roles ------------------------------------------------------------------
# GOVERNANCE_ADDRESS receives EVERY owner role at handover: Admin.admin,
# ClearingV2, UniProxy, RebalanceProxy and HypervisorFactory. On Hydration that
# is governance, not a Safe — an OpenGov referendum is the multi-party approval,
# and governance acts as the EVM address whose first 20 bytes match a dispatch
# account it controls. 0xaa7e… = dispatcher.dispatchAsAaveManager
# (Root or the EconomicParameters track), already the Aave market's ACLManager
# admin, so the path is proven. Economics study P5.
GOVERNANCE_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0
ALLOW_DEPLOYER_OWNER=false

# Becomes RebalanceProxy.rebalancers[vault] AND Admin.advisors[vault]: the
# bounded rebalance path and the compound path. A hot key, deliberately — the
# proxy's caps hold even if it is compromised. NOT the deployer on mainnet.
KEEPER_ADDRESS=

# Where the Gamma cut of harvested swap fees goes. Re-asserted by every
# rebalance, so it must match the keeper's FEE_RECIPIENT. Never the keeper key.
FEE_RECIPIENT=

# Existing Uniswap v3 stack ----------------------------------------------
# From uniswap-v3-deploy/mainnet/deployments/mainnet.json + -pool.json.
V3_FACTORY=
V3_POOL=
FEE=3000

# aDOT (asset 1001) and HOLLAR (asset 222) are Erc20-kind assets. Their
# registry contracts, not their asset-ID aliases, are the pool tokens — and by
# contract aDOT sorts FIRST. The preflight asserts this against the chain.
TOKEN_A=1001
TOKEN_B=222
EXPECT_TOKEN0=1001
EXPECT_TOKEN1=222

# Vault LP token ---------------------------------------------------------
# ERC-20 constructor args with NO setter: whatever ships here is the label a
# front end renders forever. Leave blank to derive `Gamma <sym0>-<sym1>` /
# `g<sym0>-<sym1>` from the tokens' own symbol() at deploy time.
VAULT_NAME=
VAULT_SYMBOL=

# Gamma fee (a DIVISOR, never 0) -----------------------------------------
# 5 = 20% of harvested swap fees (contract default), 255 = ~0.4%. 0 reverts every
# harvest and bricks deposit/withdraw/rebalance. Spec §H D3 leans 255 at launch
# to bootstrap LPs; total buyback share = protocolFee + (1-protocolFee)/divisor.
HYPERVISOR_FEE=255

# ClearingV2 deposit guards ----------------------------------------------
# The shipped priceThreshold is 10_000, which compares as price*10_000/priceBefore
# and therefore allows 0% deviation — every deposit reverts once a TWAP exists.
# 10_100 = 1% (spec §B).
PRICE_THRESHOLD=10100
# MUST equal the keeper's TWAP_WINDOW_SECS and be covered by the pool's ring.
TWAP_INTERVAL=3600

# Deposit-ratio band, as delta/scale. deltaScale is 10_000 on the contract, so
# 10_010 = ±0.1%. NEVER 0: `applyRatio` divides by it, so a zero here makes
# every deposit after the first revert inside FullMath.mulDiv.
DEPOSIT_DELTA=10010

# Guarded-launch caps, in RAW units (aDOT 10 decimals, HOLLAR 18, shares 18).
# Hypervisor.sol fixes its own maxima at construction with no setters, so these
# are enforced on ClearingV2 — the layer every deposit passes through. Two calls
# are needed: `customDeposit` stores them, `setDepositOverride` makes
# clearDeposit read them. 0 = no cap.
#
# Economics study P4: cap ≈ $150k of shares at launch; net-negative crossover is
# ~$200-400k at current organic flow. Fill from the seed price on the day.
MAX_TOTAL_SUPPLY=
DEPOSIT0_MAX=
DEPOSIT1_MAX=

# RebalanceProxy on-chain policy floors (spec §C) ------------------------
# These hold even if the keeper key is compromised.
MAX_TRANSLATION=500
MAX_WIDTH=300
MIN_INTERVAL=21600

# Launch band — MUST match the keeper ------------------------------------
# The band set at handover is the baseline RebalanceProxy's maxWidth is measured
# against. If the keeper's first rebalance re-mints at a width further than
# maxWidth from it, the proxy reverts and the keeper skips forever.
# 16 * 60 = 960 ticks = +10.08% / -9.16% (spec §D1: ±10% at launch).
BASE_HALF_WIDTH_MULT=16
LIMIT_WIDTH_MULT=1
LIMIT_SIDE=above

# Handover price gate ----------------------------------------------------
# 03-handover.js centres the launch band on the pool's CURRENT tick, and an
# empty pool's price is frozen at whatever `initialize()` set. Step 3 refuses
# to place a band on a price further than this from PRICE_FEED_A.
#
# Correcting the price is a separate one-off job — `11-anchor-price.js`, run by
# whoever holds a little of both tokens (see .env.anchor.example). The handover
# never moves a market price itself.
#
# 200 ticks (~2%) matches the keeper's own ORACLE_MAX_DEV_TICKS, so anything it
# tolerates the handover tolerates too.
ANCHOR_MAX_DEV_TICKS=200
# SKIP_PRICE_CHECK=true   accept the current pool price, unchecked

# Pool TWAP ring ---------------------------------------------------------
# A full ring of C slots covers (C-1) * BLOCK_TIME_SECS. Grown to 2000 by the
# uniswap-v3-deploy launch; repeated here so the preflight can check it.
TWAP_WINDOW_SECS=3600
BLOCK_TIME_SECS=2
OBS_CARDINALITY=2000

# Price sanity -----------------------------------------------------------
# Chainlink AggregatorV3, not DIA getValue(string). aDOT rebases 1:1 with DOT,
# so the DOT/USD feed is the aDOT price. HOLLAR is the USD-pegged side, so
# PRICE_FEED_B stays blank. DIA age measured median 55 min, p90 3.6 h, max 7.4 h.
PRICE_FEED_A=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702
PRICE_FEED_B=
STALE_SECONDS=28800
MAX_DIVERGENCE_BPS=200

# Money market -----------------------------------------------------------
# A PAUSED reserve makes aToken transfers revert and the pool seizes. Underlying
# (DOT precompile), not the aToken.
MM_DATA_PROVIDER=0xdf18300261edfF47b28c6a6adBCBCf468B52e5a5
MM_UNDERLYING=0x0000000000000000000000000000000100000005

# Treasury seed ----------------------------------------------------------
# Raw units. SEED_TO receives the LP shares; the treasury's own EVM identity is
# the truncated PalletId("py/trsry"), which is what dispatchAsTreasury acts as.
#
# Size BOTH SIDES AT THE POOL PRICE. The first deposit into an empty vault is the
# only one ClearingV2 does not ratio-check, so an off-ratio seed is accepted and
# then parks its excess side in the LIMIT position instead of the base — the
# vault launches lopsided and waits for the market to trade it back.
#
#   price = HOLLAR per aDOT (= DOT/USD, since HOLLAR is the $1 side)
#   SEED1 = <usd per side> * 1e18
#   SEED0 = <usd per side> / price * 1e10        (aDOT is 10 decimals)
#
# Worked example — $5,000 per side at price 0.96056844 (DIA, 2026-09-07). Recompute
# this at submission time; the price moves and a stale ratio launches lopsided:
#   SEED0=52052511739819                  5205.2512 aDOT
#   SEED1=5000000000000000000000          5000.000 HOLLAR
#   -> mints ~10,000e18 shares, because shares are denominated in token1.
#
# Shares are HOLLAR raw units, so MAX_TOTAL_SUPPLY reads directly as USD * 1e18
# and must be at least the seed's shares — clearShares runs AFTER the mint, so a
# seed over the cap reverts the whole enacted transaction. 00-preflight.js
# computes the exact figure from the live pool and checks it for you.
SEED0=
SEED1=
SEED_TO=0x6d6f646c70792f74727372790000000000000000

# Governance -------------------------------------------------------------
# Where 01-governance-calldata.js says to submit. `minimum` puts each proposal
# on the narrowest origin it needs: seed and pull on track 5 (treasurer), every
# admin call on track 9 (economic_parameters). Both dispatcher origins are
# EitherOf<EnsureRoot<_>, <narrower>>, so `root` would also work and collapses
# the launch onto one referendum — same prepare, decision and confirm periods,
# same approval curve, but a 1,000,000 HDX decision deposit rather than 750,000
# and a support curve rising to 36% rather than 18%.
GOVERNANCE_TRACK=minimum

# Transaction policy -----------------------------------------------------
# Legacy gasPrice = eth_gasPrice x this multiplier, plus a fixed gas limit. The
# runtime's EVM block cap is 20m.
GAS_PRICE_MULT=4
EVM_GAS_LIMIT=15000000
CONFIRMATIONS=2
