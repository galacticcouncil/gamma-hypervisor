# GSOL/HOLLAR — the Gamma vault's per-pool settings (runbook-cl-pool-launch §1).
# Shared settings, DEPLOYER_PK, STACK and the keeper key live in ENV_FILE
# (see .env.pools.example). 02-deploy.js copies the keeper strategy below into
# keeper/vaults/<net>-<STACK>/gsol-hollar.json.
POOL_NAME=gsol-hollar
TOKEN_A=9001
TOKEN_B=222
FEE=3000
# By contract address HOLLAR (0x531a…) sorts before GSOL (0xf5f7…): HOLLAR is token0.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=9001
# CREATE2 address on the live factory 0x776c…C354 (verified against aDOT/HOLLAR's
# pool); 00-preflight.js and 02-deploy.js check it against factory.getPool.
V3_POOL=0x16e1cBD04029566244f832a90FECc0752Cc3d419
# GSOL has no USD feed: the money market's AaveOracle prices its 2-POOL-GSOL
# reserve (stableswap 90001 -> aSOL x SOL/USD); age from the SOL/USD leg.
PRICE_FEED_A=0xAD33C0F0C42C5A0EAA65b5895D2BdB20cb6E8760
PRICE_FEED_B=
# §1e: SOL/USD age p90 2.2h, max 3.2h.
STALE_SECONDS=28800
# Reserve behind the aToken, for the money-market pause check (preflight asserts it).
MM_UNDERLYING=0x0000000000000000000000000000000100015f91

# --- caps and seed (runbook §7): ~$150k TVL cap, $50k per token per deposit, $2.5k-per-side seed,
# priced at GSOL $121.87 and HOLLAR $1 on 2026-09-30. Re-check the prices before launch.
# Raw integers: deposit caps in each token's 18-decimal units, supply in vault shares.
# 1230.801533 GSOL ≈ $150k (shares count in GSOL)
MAX_TOTAL_SUPPLY=1230801533000000000000
# 50,000 HOLLAR
DEPOSIT0_MAX=50000000000000000000000
# 410.267178 GSOL ≈ $50k
DEPOSIT1_MAX=410267178000000000000
# 2,500 HOLLAR
SEED0=2500000000000000000000
# 20.513662 GSOL ≈ $2.5k
SEED1=20513662000000000000

# --- RebalanceProxy caps (§1c; customDiff derivation in §1c "How customDiff…")
MAX_TRANSLATION=720
MAX_WIDTH=300
MIN_INTERVAL=21600

# --- band (§1c): base and limit both ±8.1%, in multiples of the 60-tick spacing
BASE_HALF_WIDTH_MULT=13
LIMIT_WIDTH_MULT=13
LIMIT_SIDE=above

# --- keeper strategy (§1c, §8) — copied into this pool's keeper vault file
REBALANCE_THRESHOLD_MULT=9
ELEVATED_HALF_WIDTH_MULT=24
FOLD_ENABLED=true
# Rebalance slippage bound, scaled to the band so it buys aDOT's price headroom
# (1000 bps at mult 16): about 16000 / BASE_HALF_WIDTH_MULT.
MINS_TOLERANCE_BPS=1250
# Vol-baseline series in the neckwork indexer: GSOL (9001) itself against USDT (10).
INDEXER_BASE_ASSET=9001
INDEXER_QUOTE_ASSET=10
# Off on purpose: a sweep tips the whole idle balance into the pool at spot,
# which is what a sandwich waits for.
COMPOUND_ENABLED=false
