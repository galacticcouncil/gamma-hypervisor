# atBTC/HOLLAR — the Gamma vault's per-pool settings (runbook-cl-pool-launch §1).
# Shared settings, DEPLOYER_PK, STACK and the keeper key live in ENV_FILE
# (see .env.pools.example). 02-deploy.js copies the keeper strategy below into
# keeper/vaults/<net>-<STACK>/atbtc-hollar.json.
POOL_NAME=atbtc-hollar
TOKEN_A=1006
TOKEN_B=222
FEE=3000
# By contract address HOLLAR (0x531a…) sorts before atBTC (0x6900…): HOLLAR is token0.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=1006
# CREATE2 address on the live factory 0x776c…C354 (verified against aDOT/HOLLAR's
# pool); 00-preflight.js and 02-deploy.js check it against factory.getPool.
V3_POOL=0xDD7E022582D055E35455952F86f76924884A9d1a
# LP token name/symbol: constructor args with no setter, so they must be right at deploy
VAULT_NAME=atBTC-HOLLAR
VAULT_SYMBOL=atBTC-HOLLAR
# tBTC/USD DIA feed = AaveOracle.getSourceOfAsset(tBTC). HOLLAR is the USD side.
PRICE_FEED_A=0xe5AcDfB0d5EC5cE34F7448B41ef4a97c4e83D9c1
PRICE_FEED_B=
# §1e: tBTC/USD age p90 4.6h, max 7.2h.
STALE_SECONDS=43200
# Reserve behind the aToken, for the money-market pause check (preflight asserts it).
MM_UNDERLYING=0x00000000000000000000000000000001000f453d

# --- caps and seed (runbook §7): ~$150k TVL cap, $50k per token per deposit, $2.5k-per-side seed,
# priced at atBTC $83599.72 and HOLLAR $1 on 2026-09-30. Re-check the prices before launch.
# Raw integers: deposit caps in each token's 18-decimal units, supply in vault shares.
# 1.794264 atBTC ≈ $150k (shares count in atBTC)
MAX_TOTAL_SUPPLY=1794264000000000000
# 50,000 HOLLAR
DEPOSIT0_MAX=50000000000000000000000
# 0.598088 atBTC ≈ $50k
DEPOSIT1_MAX=598088000000000000
# 2,500 HOLLAR
SEED0=2500000000000000000000
# 0.029904 atBTC ≈ $2.5k
SEED1=29904000000000000

# --- RebalanceProxy caps (§1c; customDiff derivation in §1c "How customDiff…")
MAX_TRANSLATION=480
MAX_WIDTH=300
MIN_INTERVAL=21600

# --- band (§1c): base and limit both ±5.5%, in multiples of the 60-tick spacing
BASE_HALF_WIDTH_MULT=9
LIMIT_WIDTH_MULT=9
LIMIT_SIDE=above

# --- keeper strategy (§1c, §8) — copied into this pool's keeper vault file
REBALANCE_THRESHOLD_MULT=6
ELEVATED_HALF_WIDTH_MULT=17
FOLD_ENABLED=true
# Rebalance slippage bound, scaled to the band so it buys aDOT's price headroom
# (1000 bps at mult 16): about 16000 / BASE_HALF_WIDTH_MULT.
MINS_TOLERANCE_BPS=1800
# Vol-baseline series in the neckwork indexer: tBTC (1000765), 1:1 with atBTC against USDT (10).
INDEXER_BASE_ASSET=1000765
INDEXER_QUOTE_ASSET=10
# Off on purpose: a sweep tips the whole idle balance into the pool at spot,
# which is what a sandwich waits for.
COMPOUND_ENABLED=false
