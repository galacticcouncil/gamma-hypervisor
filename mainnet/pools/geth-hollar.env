# GETH/HOLLAR — the Gamma vault's per-pool settings (runbook-cl-pool-launch §1).
# Shared settings, DEPLOYER_PK, STACK and the keeper key live in ENV_FILE
# (see .env.pools.example). 02-deploy.js copies the keeper strategy below into
# keeper/vaults/<net>-<STACK>/geth-hollar.json.
POOL_NAME=geth-hollar
TOKEN_A=420
TOKEN_B=222
FEE=3000
# By contract address HOLLAR (0x531a…) sorts before GETH (0x8a59…): HOLLAR is token0.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=420
# CREATE2 address on the live factory 0x776c…C354 (verified against aDOT/HOLLAR's
# pool); 00-preflight.js and 02-deploy.js check it against factory.getPool.
V3_POOL=0x9E30d2429028A436D48d0e83aC806Dcd67EF4cA7
# GETH has no USD feed: the money market's AaveOracle prices its 2-POOL-GETH
# reserve (stableswap 4200 -> aETH x ETH/USD); age from the ETH/USD leg.
PRICE_FEED_A=0xAD33C0F0C42C5A0EAA65b5895D2BdB20cb6E8760
PRICE_FEED_B=
# §1e: ETH/USD age p90 4.5h, max 9.6h.
STALE_SECONDS=57600
# Reserve behind the aToken, for the money-market pause check (preflight asserts it).
MM_UNDERLYING=0x0000000000000000000000000000000100001068

# --- caps and seed: OPEN DECISION (runbook §7) — mainnet preflight/deploy refuse until set.
# Raw integers: deposit caps in each token's 18-decimal units, supply in vault shares.
MAX_TOTAL_SUPPLY=
DEPOSIT0_MAX=
DEPOSIT1_MAX=
SEED0=
SEED1=

# --- RebalanceProxy caps (§1c; customDiff derivation in §1c "How customDiff…")
MAX_TRANSLATION=720
MAX_WIDTH=300
MIN_INTERVAL=21600

# --- band (§1c): base and limit both ±8.1%, in multiples of the 60-tick spacing
BASE_HALF_WIDTH_MULT=13
LIMIT_WIDTH_MULT=13
LIMIT_SIDE=above

# --- keeper strategy (§1c, §8) — copied into this pool's keeper vault file
REBALANCE_THRESHOLD_MULT=9
ELEVATED_HALF_WIDTH_MULT=24
FOLD_ENABLED=true
# Rebalance slippage bound, scaled to the band so it buys aDOT's price headroom
# (1000 bps at mult 16): about 16000 / BASE_HALF_WIDTH_MULT.
MINS_TOLERANCE_BPS=1250
# Vol-baseline series in the neckwork indexer: GETH (420) itself against USDT (10).
INDEXER_BASE_ASSET=420
INDEXER_QUOTE_ASSET=10
# Off until the vault is seeded — compounding an empty vault reverts every interval.
COMPOUND_ENABLED=false
