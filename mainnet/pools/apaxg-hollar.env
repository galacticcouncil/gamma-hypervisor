# aPAXG/HOLLAR — the Gamma vault's per-pool settings (runbook-cl-pool-launch §1).
# Shared settings, DEPLOYER_PK, STACK and the keeper key live in ENV_FILE
# (see .env.pools.example). 02-deploy.js copies the keeper strategy below into
# keeper/vaults/<net>-<STACK>/apaxg-hollar.json.
POOL_NAME=apaxg-hollar
TOKEN_A=1039
TOKEN_B=222
FEE=3000
# By contract address aPAXG (0x00f2…) sorts before HOLLAR (0x531a…): aPAXG is token0.
EXPECT_TOKEN0=1039
EXPECT_TOKEN1=222
# CREATE2 address on the live factory 0x776c…C354 (verified against aDOT/HOLLAR's
# pool); 00-preflight.js and 02-deploy.js check it against factory.getPool.
V3_POOL=0x419f96a1a34c422FA581E89C317C1B55563009b4
# PAXG/USD DIA feed = AaveOracle.getSourceOfAsset(PAXG). HOLLAR is the USD side.
PRICE_FEED_A=0x8fB61B8E81C2f17695F14A136C98b0C4013bc105
PRICE_FEED_B=
# §1e: PAXG/USD age p90 16.3h, max 23.1h — gold barely moves, so old is normal.
STALE_SECONDS=129600
# Reserve behind the aToken, for the money-market pause check (preflight asserts it).
MM_UNDERLYING=0x0000000000000000000000000000000100000027

# --- caps and seed (runbook §7): ~$150k TVL cap, $50k per token per deposit, $2.5k-per-side seed,
# priced at aPAXG $4184.68 and HOLLAR $1 on 2026-09-30. Re-check the prices before launch.
# Raw integers: deposit caps in each token's 18-decimal units, supply in vault shares.
# 150,000 ≈ $150k (shares count in HOLLAR)
MAX_TOTAL_SUPPLY=150000000000000000000000
# 11.948335 aPAXG ≈ $50k
DEPOSIT0_MAX=11948335000000000000
# 50,000 HOLLAR
DEPOSIT1_MAX=50000000000000000000000
# 0.597417 aPAXG ≈ $2.5k
SEED0=597417000000000000
# 2,500 HOLLAR
SEED1=2500000000000000000000

# --- RebalanceProxy caps (§1c; customDiff derivation in §1c "How customDiff…")
MAX_TRANSLATION=300
MAX_WIDTH=300
MIN_INTERVAL=21600

# --- band (§1c): base and limit both ±3.0%, in multiples of the 60-tick spacing
BASE_HALF_WIDTH_MULT=5
LIMIT_WIDTH_MULT=5
LIMIT_SIDE=above

# --- keeper strategy (§1c, §8) — copied into this pool's keeper vault file
REBALANCE_THRESHOLD_MULT=3
ELEVATED_HALF_WIDTH_MULT=9
FOLD_ENABLED=true
# Rebalance slippage bound, scaled to the band so it buys aDOT's price headroom
# (1000 bps at mult 16): about 16000 / BASE_HALF_WIDTH_MULT.
MINS_TOLERANCE_BPS=3200
# Vol-baseline series in the neckwork indexer: PAXG (39), 1:1 with aPAXG against USDT (10).
INDEXER_BASE_ASSET=39
INDEXER_QUOTE_ASSET=10
# Off on purpose: a sweep tips the whole idle balance into the pool at spot,
# which is what a sandwich waits for.
COMPOUND_ENABLED=false
