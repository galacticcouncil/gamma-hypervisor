# 11-anchor-price.js — move an EMPTY pool's price onto the oracle price.
# One-off. Run by whoever holds a little of both pool tokens; they come back.
#
#   ENV_FILE=.env.anchor node 11-anchor-price.js --dry-run
#   ENV_FILE=.env.anchor node 11-anchor-price.js

NET=mainnet
EVM_RPC_URL=https://rpc.hydradx.cloud
# Optional but recommended: enables the Omnipool cross-check of the feed.
WS_URL=wss://rpc.hydradx.cloud
CONFIRMATIONS=2

# The key that holds the tokens and signs. NOT the launch deploy key.
ANCHOR_PK=

# Already-deployed Uniswap v3 contracts. These defaults are mainnet.
POOL=0x5C6208A3c316A801f8996750aA7b6f45Fc988548
POSITION_MANAGER=0xd5029E471eE3F6F51feFb63Fed0482A74Bb310B3
SWAP_ROUTER=0x5a79dE848626994c4099640EF5c48Fd65DAe4159

# Chainlink AggregatorV3. PRICE_FEED_B blank => token1 is the USD-pegged side.
PRICE_FEED_A=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702
PRICE_FEED_B=
STALE_SECONDS=28800

# Second opinion on the feed, from the Omnipool's own price for the same pair.
# The whole run moves a real pool onto whatever the feed says, so this is the
# one input worth checking twice. Needs WS_URL.
CROSSCHECK_ASSET0=1001
CROSSCHECK_ASSET1=222
CROSSCHECK_TOKEN0=0x02639ec01313c8775Fae74F2dad1118c8A8a86dA
CROSSCHECK_TOKEN1=0x531a654d1696ED52e7275A8cede955E82620f99a
CROSSCHECK_DEC0=10
CROSSCHECK_DEC1=18
CROSSCHECK_MAX_BPS=500

# Leave the pool alone if it is already this close to the feed.
# 200 ticks (~2%) matches the keeper's own ORACLE_MAX_DEV_TICKS.
ANCHOR_MAX_DEV_TICKS=200

# The sacrificial position. Defaults are 0.2 token0 + 0.3 token1 — the swap
# eats it and then rides free to the limit, so bigger only costs more to consume.
# Both come back on burn; the real cost is gas.
# MINT_AMOUNT0=2000000000
# MINT_AMOUNT1=300000000000000000

# aDOT is an aToken: one transferFrom alone measures ~1.23M gas.
MINT_GAS=6000000
SWAP_GAS=6000000
GAS_PRICE_MULT=4
