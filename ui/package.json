{
  "name": "gamma-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "read-only text-mode dashboard + /api/v1 for the gamma keeper fleet. express + sveltekit ssr + sqlite; imports the keeper's signer-free leaf modules as @keeper/*.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@sveltejs/adapter-node": "^2.1.2",
    "@sveltejs/kit": "^2.17.3",
    "compression": "^1.7.4",
    "ethers": "^5.7.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "prom-client": "^15.1.3",
    "svelte": "^4.2.12",
    "tsx": "^4.19.2",
    "vite": "^5.1.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
